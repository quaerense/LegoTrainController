<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/btnBtConnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@null"
        android:padding="16dp"
        android:src="@drawable/ic_bluetooth_searching"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivConnectionStatus"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_led_red"
        app:layout_constraintBottom_toBottomOf="@id/btnBtConnect"
        app:layout_constraintStart_toEndOf="@id/btnBtConnect"
        app:layout_constraintTop_toTopOf="@id/btnBtConnect" />

    <TextView
        android:id="@+id/tvSpeedometer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_margin="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/digital_counter_7_italic"
        android:gravity="end"
        android:text="@string/zero"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintBottom_toBottomOf="@id/btnBtConnect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivConnectionStatus"
        app:layout_constraintTop_toTopOf="@id/btnBtConnect" />

    <com.quaerense.legotraincontroller.view.ui.SliderView
        android:id="@+id/svTrainPower"
        android:layout_width="120dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:max="510"
        android:min="0"
        android:padding="8dp"
        android:progress="255"
        android:progressDrawable="@drawable/custom_seekbar"
        android:splitTrack="false"
        android:thumb="@drawable/custom_thumb"
        app:layout_constraintBottom_toTopOf="@id/btnStop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBtConnect" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginHorizontal="16dp"
        android:backgroundTint="@android:color/holo_red_light"
        android:contentDescription="@null"
        android:padding="16dp"
        android:text="@string/stop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/svTrainPower" />

</androidx.constraintlayout.widget.ConstraintLayout>